{
  "schema_version": 1,
  "schema_id": "burn-research.agent-contracts.v1",
  "engine": "burn-research",
  "scope": "agent-workspace",
  "semantics": {
    "workspace_role": "metadata_and_control",
    "execution_truth": "LayerRegistry",
    "default_precondition_failure": "error_no_mutation",
    "recovery_expectation": "object_reusable_after_controlled_failure",
    "transactional_init_failure": "restore_pre_call_workspace_and_remove_new_registry_layer"
  },
  "state_domains": {
    "slot": {
      "states": [
        "input",
        "free",
        "reserved"
      ],
      "initial": {
        "slot_0": "input",
        "slot_1_to_n_minus_1": "free"
      },
      "readable": [
        "input",
        "reserved"
      ],
      "transitions": [
        {
          "operation": "reserveSlot",
          "from": "free",
          "to": "reserved"
        },
        {
          "operation": "releaseSlot",
          "from": "reserved",
          "to": "free"
        }
      ]
    },
    "layer_metadata": {
      "states": [
        "reserved",
        "initialized"
      ],
      "execution_authority": "LayerRegistry"
    }
  },
  "predicates": {
    "owner.non_empty": {
      "parameters": [
        "owner"
      ]
    },
    "slot.free_exists": {
      "parameters": []
    },
    "slot.in_workspace_range": {
      "parameters": [
        "slot"
      ]
    },
    "slot.readable": {
      "parameters": [
        "slot"
      ],
      "allowed_states": [
        "input",
        "reserved"
      ]
    },
    "slot.state_reserved": {
      "parameters": [
        "slot"
      ]
    },
    "spec.unary": {
      "parameters": [
        "spec"
      ]
    },
    "spec.binary": {
      "parameters": [
        "spec"
      ]
    },
    "registry.layer_absent": {
      "parameters": [
        "spec"
      ]
    },
    "registry.identity_exact": {
      "parameters": [
        "spec"
      ],
      "proof": "validated_init_fingerprint"
    },
    "workspace.layer_reserved": {
      "parameters": [
        "layer_id"
      ]
    },
    "label.within_limit": {
      "parameters": [
        "label"
      ],
      "max_bytes": 4000
    },
    "builder.output_written": {
      "parameters": [
        "slot"
      ]
    },
    "layout.edge_not_known_incompatible": {
      "parameters": [
        "slot",
        "spec"
      ],
      "policy": {
        "known_incompatible": "reject",
        "unknown": "allow_and_defer_to_runtime"
      },
      "proof": "canonical_workspace_slot_producer_type_variant"
    },
    "runtime_subject.bound": {
      "parameters": [],
      "authority": "AgentWorkspace.runtime_subject_binding"
    },
    "runtime_program.bind_admissible": {
      "parameters": [
        "program_identity"
      ],
      "rule": "exact_duplicate_already_bound OR binding_count < 32",
      "duplicate_policy": "idempotent_success",
      "new_identity_policy": "requires_free_capacity",
      "authority": "AgentWorkspace bounded exact program identity set"
    }
  },
  "operations": {
    "reserveSlot": {
      "surface": "AgentWorkspace.reserveSlot",
      "arguments": [
        {
          "name": "owner",
          "type": "string"
        }
      ],
      "preconditions": [
        {
          "predicate": "owner.non_empty",
          "bind": {
            "owner": "owner"
          }
        },
        {
          "predicate": "slot.free_exists"
        }
      ],
      "success": {
        "returns": "slot:u8",
        "effects": [
          "slot.state:free->reserved",
          "slot.owner:set"
        ]
      },
      "failure": {
        "state_change": "none",
        "reusable": true
      }
    },
    "releaseSlot": {
      "surface": "AgentWorkspace.releaseSlot",
      "arguments": [
        {
          "name": "slot",
          "type": "u8"
        }
      ],
      "preconditions": [
        {
          "predicate": "slot.in_workspace_range",
          "bind": {
            "slot": "slot"
          }
        },
        {
          "predicate": "slot.state_reserved",
          "bind": {
            "slot": "slot"
          }
        }
      ],
      "success": {
        "returns": "unit",
        "effects": [
          "slot.state:reserved->free",
          "slot.owner:clear"
        ]
      },
      "failure": {
        "state_change": "none",
        "reusable": true
      }
    },
    "workspaceInitUnary": {
      "surface": "workspaceInitUnary",
      "arguments": [
        {
          "name": "spec",
          "type": "AgentLayerSpec"
        },
        {
          "name": "input_slot",
          "type": "u8"
        },
        {
          "name": "label",
          "type": "string"
        }
      ],
      "preconditions": [
        {
          "predicate": "spec.unary",
          "bind": {
            "spec": "spec"
          }
        },
        {
          "predicate": "slot.readable",
          "bind": {
            "slot": "input_slot"
          }
        },
        {
          "predicate": "registry.layer_absent",
          "bind": {
            "spec": "spec"
          }
        },
        {
          "predicate": "workspace.layer_reserved",
          "bind": {
            "layer_id": "spec.layer_id"
          }
        },
        {
          "predicate": "label.within_limit",
          "bind": {
            "label": "label"
          }
        },
        {
          "predicate": "slot.free_exists"
        }
      ],
      "semantic_preconditions": [
        {
          "predicate": "layout.edge_not_known_incompatible",
          "bind": {
            "slot": "input_slot",
            "spec": "spec"
          }
        }
      ],
      "success": {
        "returns": "output_slot:u8",
        "effects": [
          "output_slot:free->reserved",
          "registry.layer:init",
          "workspace.layer:initialized",
          "builder.step:+1"
        ]
      },
      "failure": {
        "precondition_failure": "no_mutation",
        "transactional_failure": "restore_pre_call_workspace",
        "output_reservation_rollback": "workspace_checkpoint_restore",
        "registry_post_init_rollback": "destroy_newly_initialized_layer",
        "builder_error": "no_step_committed",
        "reusable": true
      },
      "implementation_guards": [
        {
          "guard": "builder.slot_in_range",
          "bind": {
            "slot": "input_slot"
          }
        }
      ],
      "post_reservation_guards": [
        {
          "guard": "builder.slot_in_range",
          "bind": {
            "slot": "output_slot"
          },
          "source": "auto_reserved_output",
          "failure": "workspace_checkpoint_restore"
        }
      ]
    },
    "workspaceInitBinary": {
      "surface": "workspaceInitBinary",
      "arguments": [
        {
          "name": "spec",
          "type": "AgentLayerSpec"
        },
        {
          "name": "left_slot",
          "type": "u8"
        },
        {
          "name": "right_slot",
          "type": "u8"
        },
        {
          "name": "label",
          "type": "string"
        }
      ],
      "preconditions": [
        {
          "predicate": "spec.binary",
          "bind": {
            "spec": "spec"
          }
        },
        {
          "predicate": "slot.readable",
          "bind": {
            "slot": "left_slot"
          }
        },
        {
          "predicate": "slot.readable",
          "bind": {
            "slot": "right_slot"
          }
        },
        {
          "predicate": "registry.layer_absent",
          "bind": {
            "spec": "spec"
          }
        },
        {
          "predicate": "workspace.layer_reserved",
          "bind": {
            "layer_id": "spec.layer_id"
          }
        },
        {
          "predicate": "label.within_limit",
          "bind": {
            "label": "label"
          }
        },
        {
          "predicate": "slot.free_exists"
        }
      ],
      "success": {
        "returns": "output_slot:u8",
        "effects": [
          "output_slot:free->reserved",
          "registry.layer:init",
          "workspace.layer:initialized",
          "builder.step:+1"
        ]
      },
      "failure": {
        "precondition_failure": "no_mutation",
        "transactional_failure": "restore_pre_call_workspace",
        "output_reservation_rollback": "workspace_checkpoint_restore",
        "registry_post_init_rollback": "destroy_newly_initialized_layer",
        "builder_error": "no_step_committed",
        "reusable": true
      },
      "implementation_guards": [
        {
          "guard": "builder.slot_in_range",
          "bind": {
            "slot": "left_slot"
          }
        },
        {
          "guard": "builder.slot_in_range",
          "bind": {
            "slot": "right_slot"
          }
        }
      ],
      "post_reservation_guards": [
        {
          "guard": "builder.slot_in_range",
          "bind": {
            "slot": "output_slot"
          },
          "source": "auto_reserved_output",
          "failure": "workspace_checkpoint_restore"
        }
      ]
    },
    "workspaceWireUnary": {
      "surface": "workspaceWireUnary",
      "arguments": [
        {
          "name": "spec",
          "type": "AgentLayerSpec"
        },
        {
          "name": "input_slot",
          "type": "u8"
        },
        {
          "name": "label",
          "type": "string"
        }
      ],
      "preconditions": [
        {
          "predicate": "spec.unary",
          "bind": {
            "spec": "spec"
          }
        },
        {
          "predicate": "slot.readable",
          "bind": {
            "slot": "input_slot"
          }
        },
        {
          "predicate": "registry.identity_exact",
          "bind": {
            "spec": "spec"
          }
        },
        {
          "predicate": "label.within_limit",
          "bind": {
            "label": "label"
          }
        },
        {
          "predicate": "slot.free_exists"
        }
      ],
      "semantic_preconditions": [
        {
          "predicate": "layout.edge_not_known_incompatible",
          "bind": {
            "slot": "input_slot",
            "spec": "spec"
          }
        }
      ],
      "success": {
        "returns": "output_slot:u8",
        "effects": [
          "output_slot:free->reserved",
          "workspace.layer:initialized",
          "builder.step:+1"
        ]
      },
      "failure": {
        "precondition_failure": "no_mutation",
        "output_reservation_rollback": "release_output_slot",
        "reusable": true
      },
      "implementation_guards": [
        {
          "guard": "builder.slot_in_range",
          "bind": {
            "slot": "input_slot"
          }
        }
      ],
      "post_reservation_guards": [
        {
          "guard": "builder.slot_in_range",
          "bind": {
            "slot": "output_slot"
          },
          "source": "auto_reserved_output",
          "failure": "release_output_slot"
        }
      ]
    },
    "workspaceWireBinary": {
      "surface": "workspaceWireBinary",
      "arguments": [
        {
          "name": "spec",
          "type": "AgentLayerSpec"
        },
        {
          "name": "left_slot",
          "type": "u8"
        },
        {
          "name": "right_slot",
          "type": "u8"
        },
        {
          "name": "label",
          "type": "string"
        }
      ],
      "preconditions": [
        {
          "predicate": "spec.binary",
          "bind": {
            "spec": "spec"
          }
        },
        {
          "predicate": "slot.readable",
          "bind": {
            "slot": "left_slot"
          }
        },
        {
          "predicate": "slot.readable",
          "bind": {
            "slot": "right_slot"
          }
        },
        {
          "predicate": "registry.identity_exact",
          "bind": {
            "spec": "spec"
          }
        },
        {
          "predicate": "label.within_limit",
          "bind": {
            "label": "label"
          }
        },
        {
          "predicate": "slot.free_exists"
        }
      ],
      "success": {
        "returns": "output_slot:u8",
        "effects": [
          "output_slot:free->reserved",
          "workspace.layer:initialized",
          "builder.step:+1"
        ]
      },
      "failure": {
        "precondition_failure": "no_mutation",
        "output_reservation_rollback": "release_output_slot",
        "reusable": true
      },
      "implementation_guards": [
        {
          "guard": "builder.slot_in_range",
          "bind": {
            "slot": "left_slot"
          }
        },
        {
          "guard": "builder.slot_in_range",
          "bind": {
            "slot": "right_slot"
          }
        }
      ],
      "post_reservation_guards": [
        {
          "guard": "builder.slot_in_range",
          "bind": {
            "slot": "output_slot"
          },
          "source": "auto_reserved_output",
          "failure": "release_output_slot"
        }
      ]
    },
    "workspaceCompile": {
      "surface": "workspaceCompile",
      "arguments": [
        {
          "name": "output_slot",
          "type": "u8"
        }
      ],
      "preconditions": [
        {
          "predicate": "builder.output_written",
          "bind": {
            "slot": "output_slot"
          }
        }
      ],
      "success": {
        "returns": "CompiledGraph",
        "effects": [
          "none"
        ]
      },
      "failure": {
        "state_change": "none",
        "builder_output_selection": "unchanged",
        "reusable": true
      },
      "implementation_guards": [
        {
          "guard": "builder.slot_in_range",
          "bind": {
            "slot": "output_slot"
          }
        }
      ],
      "class": "legacy_unbound_or_escape_hatch",
      "subject_bound_policy": "does not register program identity; workspaceVerifyGraphReceipt fails closed for a bound runtime subject unless the exact identity was previously registered by workspaceCompileForRuntimeSubject"
    },
    "workspaceCompileForRuntimeSubject": {
      "surface": "workspaceCompileForRuntimeSubject",
      "arguments": [
        {
          "name": "output_slot",
          "type": "u8"
        }
      ],
      "preconditions": [
        {
          "predicate": "runtime_subject.bound"
        },
        {
          "predicate": "control_domain.slot_count_match"
        },
        {
          "predicate": "builder.output_written",
          "bind": {
            "slot": "output_slot"
          }
        },
        {
          "predicate": "runtime_program.bind_admissible",
          "bind": {
            "program_identity": "compiled_graph.programIdentity"
          }
        }
      ],
      "success": {
        "returns": "CompiledGraph",
        "effects": [
          "compile:non_mutating_builder_and_registry",
          "workspace.runtime_program_identity:exact_programIdentity_bind_idempotent"
        ],
        "authority": "CompiledGraph.programIdentity exact string"
      },
      "failure": {
        "state_change": "none_on_subject_domain_compile_or_binding_failure",
        "builder_output_selection": "unchanged",
        "reusable": true
      },
      "implementation_guards": [
        {
          "guard": "builder.slot_in_range",
          "bind": {
            "slot": "output_slot"
          }
        }
      ]
    }
  },
  "proof_observables": [
    "AgentWorkspace.snapshot",
    "AgentWorkspace.get",
    "AgentGraphBuilder.numSteps",
    "LayerRegistry.layerExists",
    "LayerRegistry.layerInitFingerprint",
    "LayerRegistry.totalParams",
    "workspaceRuntimeProgramBinding",
    "CompiledGraph.programIdentity"
  ],
  "compatibility": {
    "unknown_schema_version": "reject",
    "unknown_predicate": "reject",
    "unknown_operation": "ignore_unless_requested"
  },
  "implementation_guards": {
    "builder.slot_in_range": {
      "parameters": [
        "slot"
      ],
      "authority": "AgentGraphBuilder.numSlots",
      "failure": "controlled_error_no_unexpected_mutation"
    }
  },
  "surface_inventory": {
    "workspace": {
      "constructor": "AgentWorkspace",
      "contracted_direct": [
        "reserveSlot",
        "releaseSlot"
      ],
      "noncanonical_mutators": [
        "reserveLayerId",
        "syncLayer",
        "forgetLayer",
        "recordProof",
        "recordEvent",
        "put",
        "remove"
      ],
      "read_only": [
        "get",
        "query",
        "tableNames",
        "snapshot",
        "limits"
      ]
    },
    "free_operations": [
      "workspaceInitUnary",
      "workspaceInitBinary",
      "workspaceWireUnary",
      "workspaceWireBinary",
      "workspaceCompile",
      "workspaceCompileForRuntimeSubject"
    ],
    "escape_hatches": [
      "workspaceCompile",
      "AgentLayerSpec",
      "AgentGraphBuilder",
      "LayerRegistry",
      "raw_protocol"
    ],
    "subject_bound_canonical": [
      "workspaceCompileForRuntimeSubject"
    ]
  }
}
