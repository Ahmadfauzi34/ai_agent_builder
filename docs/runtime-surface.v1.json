  "evolution": {
    "policy": "evidence-backed reference contract, not a ceiling on future capabilities",
    "additive_change": "add capability sources or host contracts with their owner and authority boundary, then regenerate the actual surface",
    "meaning_change": "version a contract when an existing field or authority meaning changes"
  }
