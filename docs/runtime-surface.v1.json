  "fingerprint": {
    "algorithm": "sha256",
    "canonicalization": "UTF-8 compact JSON with recursively sorted object keys and preserved array order; fingerprint field omitted",
    "scope": "artifact digests, generated binding and raw module projections, runtime capability JSON, operation-registry source contract bytes, plus Node host contract definitions and their digests",
    "authority": "artifact consistency and correlation only; not a signature, provenance proof, or action authorization"
  },
  "authority_boundaries": {
    "wasm": "Rust/Burn reference machine owns numerical execution and WASM capability descriptions",
    "node_host": "Node contracts describe optional trust, replay, receipt, state handoff, durable promotion-lineage, and operation-planning projections outside the WASM export surface",
